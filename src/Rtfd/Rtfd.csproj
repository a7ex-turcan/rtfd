<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one executable: `rtfd serve`, `rtfd run`, `rtfd validate`, the `rtfd-git` MCP server
    (`rtfd git-tools`) and the rest are all modes of this binary.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rtfd</RootNamespace>
    <AssemblyName>rtfd</AssemblyName>

    <Version>0.1.0-dev</Version>
    <Product>rtfd</Product>
    <Description>Read The Fine Diff: a PR review watcher for any AI agent.</Description>

    <!-- LibraryImport generates unsafe marshalling code: Processes/ChildProcessJob.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rtfd.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- gitleaks' rules, converted by scripts/gitleaks-rules.cs, with gitleaks' MIT notice. -->
    <EmbeddedResource Include="Resources/gitleaks-rules.json" LogicalName="Rtfd.Resources.gitleaks-rules.json" />
    <EmbeddedResource Include="Resources/gitleaks-LICENSE.txt" LogicalName="Rtfd.Resources.gitleaks-LICENSE.txt" />
    <EmbeddedResource Include="State/schema.sql" LogicalName="Rtfd.State.schema.sql" />
  </ItemGroup>

</Project>
