<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects are executables, run by Microsoft.Testing.Platform (global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rtfd/Rtfd.csproj" />

    <!-- Built first, not referenced: the tests run it as an agent CLI (FakeAgent.Executable). -->
    <ProjectReference Include="../FakeAgent/FakeAgent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
